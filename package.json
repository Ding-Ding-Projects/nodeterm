{
  "name": "node-terminal",
  "version": "0.3.4",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "description": "node-based terminal manager — multiple draggable, zoomable terminals on a single canvas.",
  "author": {
    "name": "enes",
    "email": "eneskirca@gmail.com"
  },
  "license": "BUSL-1.1",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run host:build && npm run build:codex-relay",
    "build:codex-relay": "node scripts/build-codex-relay.mjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:unit": "vitest run test/remote",
    "rebuild": "node scripts/rebuild-windows.mjs",
    "server:build": "esbuild src/server/main.ts --bundle --platform=node --format=cjs --outfile=out/server/main.cjs --external:node-pty --external:ws --external:smart-whisper --tsconfig=tsconfig.node.json",
    "host:build": "esbuild src/session-host/host.ts --bundle --platform=node --format=cjs --outfile=out/session-host/host.cjs --external:node-pty --tsconfig=tsconfig.node.json",
    "server:start": "node out/server/main.cjs",
    "server:dev": "npm run build && npm run server:build && node out/server/main.cjs",
    "make-icon": "node scripts/make-icon.mjs",
    "make-social": "node scripts/make-social.mjs",
    "dist": "npm run dist:win",
    "dist:win": "npm run make-icon && npm run build && electron-builder --win squirrel --x64 --publish never",
    "release": "npm run dist:win",
    "postinstall": "electron-rebuild -f -w node-pty,smart-whisper"
  },
  "build": {
    "appId": "com.nodeterm.app",
    "productName": "nodeterm",
    "afterPack": "./scripts/after-pack-windows.cjs",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "nodeTermUpdates": "disabled"
    },
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/smart-whisper/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "squirrel",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "signExecutable": false,
      "signAndEditExecutable": false
    },
    "squirrelWindows": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "iconUrl": "https://raw.githubusercontent.com/Ding-Ding-Projects/nodeterm/3dd1ca024f89afdb54e6d97dc8ce13004e8eeac8/build/icon.ico",
      "msi": false
    },
    "publish": {
      "provider": "github",
      "owner": "eneskirca",
      "repo": "nodeterm",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "emoji-picker-react": "^4.19.1",
    "lucide-react": "^0.545.0",
    "marked": "^12.0.2",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "smart-whisper": "^0.8.1",
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.11.3",
    "electron": "^42.9.1",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
